{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rl-training.local/schemas/model-artifact-manifest-0.13.0.json",
  "title": "RL model artifact manifest 0.13.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_version", "contract", "identity",
    "observation_schema", "action_schema", "model_architecture_id",
    "tensor_dtype", "input_shape", "action_shape", "value_shape",
    "artifact_uri", "model_file", "size_bytes", "seed", "train_updates",
    "trained_samples", "training_config_digest", "training_semantics",
    "published_at_unix_ms", "ready"
  ],
  "properties": {
    "manifest_schema_version": {"const": 2},
    "contract": {"$ref": "#/$defs/contractIdentity"},
    "identity": {"$ref": "#/$defs/modelIdentity"},
    "observation_schema": {"$ref": "#/$defs/schemaIdentity"},
    "action_schema": {"$ref": "#/$defs/schemaIdentity"},
    "model_architecture_id": {"type": "string", "minLength": 1},
    "tensor_dtype": {"type": "string", "minLength": 1},
    "input_shape": {"type": "array", "minItems": 1},
    "action_shape": {"type": "array", "minItems": 1},
    "value_shape": {"type": "array", "minItems": 1},
    "artifact_uri": {"type": "string", "pattern": "^file:///.*/models/train/[0-9]{7,}/SaveModel\\.onnx$"},
    "model_file": {"const": "SaveModel.onnx"},
    "size_bytes": {"type": "integer", "minimum": 1},
    "seed": {"type": "integer"},
    "train_updates": {"type": "integer", "minimum": 0},
    "trained_samples": {"type": "integer", "minimum": 0},
    "training_config_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "training_semantics": {"$ref": "#/$defs/trainingSemantics"},
    "published_at_unix_ms": {"type": "integer", "minimum": 1},
    "ready": {"type": "boolean"},
    "package": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "schemaIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "canonical_digest"],
      "properties": {
        "schema_id": {"type": "string", "minLength": 1},
        "schema_version": {"type": "integer", "minimum": 1},
        "canonical_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "contractIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_name", "package_version", "source_digest", "artifact_digest", "platform", "generator_identity"],
      "properties": {
        "package_name": {"const": "rl-contracts"},
        "package_version": {"const": "0.13.0"},
        "source_digest": {"$ref": "#/$defs/digest"},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "platform": {"type": "string", "minLength": 1},
        "generator_identity": {"$ref": "#/$defs/digest"}
      }
    },
    "modelIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_lineage_id", "model_step", "artifact_digest", "manifest_digest"],
      "properties": {
        "model_lineage_id": {"type": "string", "minLength": 1},
        "model_step": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "manifest_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "trainingSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["training_contract_id", "observation_schema", "action_schema", "reward_schema", "policy_distribution_schema_id", "model_architecture_id", "semantics_digest"],
      "properties": {
        "training_contract_id": {"type": "string", "minLength": 1},
        "observation_schema": {"$ref": "#/$defs/schemaIdentity"},
        "action_schema": {"$ref": "#/$defs/schemaIdentity"},
        "reward_schema": {"$ref": "#/$defs/schemaIdentity"},
        "policy_distribution_schema_id": {"type": "string", "minLength": 1},
        "model_architecture_id": {"type": "string", "minLength": 1},
        "semantics_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
