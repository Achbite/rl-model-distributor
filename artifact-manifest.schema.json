{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rl-training.local/schemas/model-artifact-manifest-0.2.0.json",
  "title": "RL model artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "model_version",
    "artifact_uri",
    "sha256",
    "ready"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "type": "string",
      "pattern": "^0\\.[1-9][0-9]*\\.[0-9]+$"
    },
    "model_version": {
      "type": "integer",
      "minimum": 0
    },
    "artifact_uri": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "shape": {
      "type": "object"
    },
    "ready": {
      "type": "boolean"
    }
  }
}
